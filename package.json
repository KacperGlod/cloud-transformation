{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./build/potree/potree.js",
  "scripts": {
    "start": "node server.js",
    "test:flight": "node --test tests/flight-controls.test.mjs tests/wheel-navigation.test.mjs",
    "test:library": "node --test tests/cloud-sorting.test.mjs",
    "test:comparison": "node --test tests/comparison.test.mjs",
    "test:lineage": "node --test tests/cloud-lineage.test.mjs",
    "test:layers": "node --test tests/pointcloud-cache.test.mjs",
    "dev": "gulp watch",
    "build": "gulp build pack",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "rollup": "^1.31.1",
    "through": "~2.3.4"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE"
}
